rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isHROrAdmin() {
      return getUserRole() in ['hr', 'admin'];
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // ─── Users Collection ───────────────────────────────────
    match /users/{userId} {
      // User can read/write own document; HR/Admin can read all
      allow read: if isAuthenticated() && (isOwner(userId) || isHROrAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Complaints Collection ───────────────────────────────
    match /complaints/{complaintId} {
      // User can read own complaints; HR can read all BUT NOT anonymous user identity
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isHROrAdmin()
      );
      allow create: if isAuthenticated();
      // Only HR/Admin can update status; user can update own complaint
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isHROrAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Evidence Collection ───────────────────────────────
    match /evidence/{evidenceId} {
      // Users can read/write own evidence; HR can read for cases they manage
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isHROrAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ─── Organizations Collection ──────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── SOS Alerts Collection ────────────────────────────
    match /sos_alerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ─── Notifications Collection ─────────────────────────
    match /notifications/{notifId} {
      allow read: if isHROrAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
